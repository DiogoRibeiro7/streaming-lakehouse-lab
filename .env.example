# ============================================================
# Streaming Lakehouse Lab - Environment Configuration
# ============================================================
# Copy this file to .env and update values as needed
# WARNING: These are sample credentials for local development only
# NEVER commit .env with real credentials to version control

# ------------------------------------------------------------
# Kafka Configuration
# ------------------------------------------------------------
KAFKA_BROKER=kafka:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk  # Sample KRaft cluster ID
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093

# Kafka Topics
KAFKA_TOPIC_EVENTS=streaming.events
KAFKA_TOPIC_METRICS=streaming.metrics
KAFKA_TOPIC_ORDERS=streaming.orders
KAFKA_TOPIC_TICKS=ticks
KAFKA_TOPIC_SENSORS=sensors
KAFKA_TOPIC_CDC=cdc.app.public_users

# ------------------------------------------------------------
# Flink Configuration
# ------------------------------------------------------------
FLINK_JOBMANAGER_RPC_ADDRESS=flink-jobmanager
FLINK_JOBMANAGER_RPC_PORT=6123
FLINK_JOBMANAGER_UI_PORT=8081
FLINK_TASKMANAGER_SLOTS=4

# Flink SQL Gateway
FLINK_SQL_GATEWAY_PORT=8083
FLINK_SQL_GATEWAY_URL=http://localhost:8083

# Resource Configuration
FLINK_JOBMANAGER_MEMORY=1600m
FLINK_TASKMANAGER_MEMORY=1728m
FLINK_TASKMANAGER_CPU=1.0

# ------------------------------------------------------------
# MinIO (S3-compatible Object Storage)
# ------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123  # SAMPLE PASSWORD - Change in production!
MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# S3 Bucket Configuration
S3_BUCKET=lakehouse
S3_WAREHOUSE_PATH=s3a://lakehouse/warehouse
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123  # SAMPLE SECRET - Change in production!

# AWS SDK Configuration (for MinIO)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123  # SAMPLE SECRET - Change in production!
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_PATH_STYLE_ACCESS=true

# ------------------------------------------------------------
# PostgreSQL (Iceberg Catalog)
# ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iceberg_catalog
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=iceberg123  # SAMPLE PASSWORD - Change in production!

# JDBC URL
CATALOG_JDBC_URL=jdbc:postgresql://postgres:5432/iceberg_catalog
CATALOG_JDBC_USER=iceberg
CATALOG_JDBC_PASSWORD=iceberg123  # SAMPLE PASSWORD - Change in production!

# ------------------------------------------------------------
# Iceberg Configuration
# ------------------------------------------------------------
ICEBERG_CATALOG_NAME=iceberg_catalog
ICEBERG_CATALOG_TYPE=jdbc
ICEBERG_WAREHOUSE=s3a://lakehouse/warehouse
ICEBERG_NAMESPACE=streaming_lakehouse

# Table Configuration
ICEBERG_FILE_FORMAT=parquet
ICEBERG_COMPRESSION=snappy

# ------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------
APP_NAME=streaming-lakehouse-lab
APP_ENV=development
LOG_LEVEL=INFO

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Java Configuration
JAVA_TOOL_OPTIONS=-Xmx1g -Xms512m

# ------------------------------------------------------------
# Monitoring & Observability
# ------------------------------------------------------------
# MISSING_DOC: Add Prometheus/Grafana configuration
# MISSING_DOC: Add metrics endpoints configuration

# ------------------------------------------------------------
# Network Configuration
# ------------------------------------------------------------
COMPOSE_PROJECT_NAME=lakehouse
DOCKER_NETWORK=lakehouse-network

# ------------------------------------------------------------
# Development Settings
# ------------------------------------------------------------
DEBUG=false
HOT_RELOAD=false

# Pre-commit Configuration
SKIP_PRE_COMMIT=false

# Testing
RUN_INTEGRATION_TESTS=true
TEST_TIMEOUT=300

# MISSING_VALIDATION: Add environment variable validation script
